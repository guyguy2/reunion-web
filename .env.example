# Copy to .env for local development. Never commit real values.
CLASS_PASSCODE=change-me
ADMIN_PASSCODE=change-me-too
SESSION_SECRET=generate-a-long-random-string
DATA_DIR=./data
PORT=3000
# Shared Google Photos album link (grants access to whoever has it, so keep it out of git)
GOOGLE_PHOTOS_ALBUM_URL=
# Optional: overrides music.youtubePlaylistId in content/event.json
YOUTUBE_PLAYLIST_ID=
