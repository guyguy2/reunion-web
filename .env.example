# Copy to .env for local development. Never commit real values.
CLASS_PASSCODE=change-me
ADMIN_PASSCODE=change-me-too
SESSION_SECRET=generate-a-long-random-string
DATA_DIR=./data
PORT=3000
# Full shared album link (https://photos.google.com/share/...?key=...), not the short goo.gl one. Grants access to whoever has it, so keep it out of git)
GOOGLE_PHOTOS_ALBUM_URL=
# Optional: overrides music.youtubePlaylistId in content/event.json
YOUTUBE_PLAYLIST_ID=
# The real event details as JSON, same shape as content/event.json (which is only a placeholder). Single quotes allow several lines.
EVENT_JSON=
# Optional. Turns on email through Resend (sign-in links, note alerts and feedback)
# RESEND_API_KEY=
# Resend sender address. Resend's default test sender only delivers to your own Resend account, so classmates need a verified domain
# EMAIL_FROM=
# Where feedback messages are emailed
# FEEDBACK_TO=
# Without Resend: the web app URL (ending in /exec) of scripts/gmail-relay.gs deployed in the Gmail account to send from
# GMAIL_RELAY_URL=
# A long random string, the same as the SECRET script property of the deployed relay
# GMAIL_RELAY_SECRET=
# The site's address, for links in emails. Defaults to the Railway domain, then to the request's address
# PUBLIC_URL=
