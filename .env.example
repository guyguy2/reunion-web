# Copy to .env for local development. Never commit real values.
CLASS_PASSCODE=change-me
ADMIN_PASSCODE=change-me-too
SESSION_SECRET=generate-a-long-random-string
DATA_DIR=./data
PORT=3000
# Full shared album link (https://photos.google.com/share/...?key=...), not the short goo.gl one. Grants access to whoever has it, so keep it out of git)
GOOGLE_PHOTOS_ALBUM_URL=
# Optional: overrides music.youtubePlaylistId in content/event.json
YOUTUBE_PLAYLIST_ID=
# The real event details as JSON, same shape as content/event.json (which is only a placeholder). Single quotes allow several lines.
EVENT_JSON=
